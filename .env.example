# =========================================================
# Gemini — usado por componentes de las Entregas 2 y 3
# No subir el archivo .env real con claves al repositorio.
# =========================================================

GOOGLE_API_KEY=tu_clave_de_gemini_aqui
GEMINI_API_KEY=tu_clave_de_gemini_aqui

GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001


# =========================================================
# Ollama — usado por el agente de la Entrega 4
# Debe estar instalado localmente y con los modelos descargados.
# =========================================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text


# =========================================================
# LangSmith — observabilidad y trazas de la Entrega 4
# LANGSMITH_API_KEY es opcional para ejecutar localmente,
# pero necesaria para visualizar trazas en LangSmith.
# =========================================================

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=tu_clave_de_langsmith_aqui
LANGSMITH_PROJECT=tecnosupply-agente-entrega4